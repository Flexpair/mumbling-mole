{
  // Use Renovate's schema for validation & autocompletion in IDEs
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Base preset: sensible defaults (groups, schedules, etc.)
  "extends": [ "config:recommended" ],

  // Set timezone for scheduling rules
  "timezone": "Europe/Berlin",

  // Enable managers to scan dependencies from
  "enabledManagers": [ "npm", "github-actions" ],

  // Always bump ranges instead of replacing with new ranges
  "rangeStrategy": "bump",

  // Only rebase PRs if they’re conflicted (reduces CI churn)
  "rebaseWhen": "conflicted",

  // Use Conventional Commits for dependency updates
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",

  // Tag PRs
  "labels": [ "dependencies" ],

  // Don’t auto-assign or auto-request reviews (you can set your team here if useful)
  "assignees": [ ],
  "reviewers": [ ],

  // Rate limiting to avoid spamming
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,

  // Run scheduled updates early Monday morning
  "schedule": [ "before 06:00 on Monday" ],

  // Refresh lockfiles once per month
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [ "before 06:00 on the first day of the month" ]
  },

  // Rules for different dependency types
  "packageRules": [
    {
      // Dev dependencies → auto-merge patch/minor
      "matchManagers": [ "npm" ],
      "matchDepTypes": [ "devDependencies" ],
      "matchUpdateTypes": [ "minor", "patch" ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      // Major npm updates → grouped & require manual approval
      "matchManagers": [ "npm" ],
      "matchUpdateTypes": [ "major" ],
      "groupName": "npm major updates",
      "prPriority": -1,
      "dependencyDashboardApproval": true
    },
    {
      // GitHub Actions → auto-merge patch/minor
      "matchManagers": [ "github-actions" ],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": [ "minor", "patch" ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      // Group tooling deps (linters, bundlers, TS types, etc.)
      // Use matchPackageNames with regex strings as per current Renovate schema.
      "groupName": "tooling (linters, bundlers, types)",
      "matchUpdateTypes": [ "minor", "patch" ],
      "automerge": true,
      "matchPackageNames": [
        "/^eslint/",
        "/^prettier/",
        "/^@types\\//",
        "/^vitest/",
        "/^jest/",
        "/^webpack/",
        "/^vite/",
        "/^rollup/",
        "/^babel/"
      ]
    },
    {
      // App runtime deps → auto-merge patch only
      "matchManagers": [ "npm" ],
      "matchDepTypes": [ "dependencies" ],
      "matchUpdateTypes": [ "patch" ],
      "automerge": true,
      "automergeType": "branch"
    }
  ],

  // General toggles
  "enabled": true,
  "dependencyDashboard": true, // central dashboard issue with updates
  "recreateWhen": "always", // re-create PRs if config changes
  "pinDigests": true // pin GitHub Action versions by commit digest
}