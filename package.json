{
  "name": "mumbling-mole",
  "version": "0.5.1",
  "description": "An HTML5 Mumble client.",
  "scripts": {
    "build": "npm install node-polyfill-webpack-plugin && webpack && ([ -f dist/config.local.js ] || cp app/config.local.js dist/) && cp app/recorder-worker.js dist/",
    "prepare": "if [ -z \"$SKIP_PREPARE\" ]; then rm -rf dist && mkdir -p dist && npm run build; fi",
    "test:unit": "jest --runInBand",
    "test:audio-context": "node scripts/test-audio-context.cjs",
    "test:e2e": "node scripts/e2e-check.cjs",
    "test:console": "node scripts/test-console-errors.cjs",
    "test:bundle": "node scripts/test-bundle-exports.cjs",
    "test:bundle:static": "node scripts/test-bundle-exports-static.cjs",
    "test:fast": "npm run test:unit && npm run test:audio-context",
    "test": "npm run test:unit && npm run test:audio-context && ( [ -n \"$SKIP_E2E\" ] || npm run test:e2e )"
  },
  "author": "Jens Fielenbach <flexpair@icloud.com>",
  "license": "ISC",
  "repository": "Flexpair/mumbling-mole",
  "homepage": "https://github.com/jafudi/flexpair",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@babel/core": "7.18.5",
    "@babel/plugin-transform-runtime": "7.18.5",
    "@babel/preset-env": "7.18.2",
    "@babel/runtime": "7.18.3",
    "babel-jest": "29.7.0",
    "babel-loader": "8.2.5",
    "brfs": "2.0.2",
    "bytebuffer": "5.0.1",
    "css-loader": "3.6.0",
    "dompurify": "2.3.8",
    "drop-stream": "1.0.0",
    "extract-loader": "5.1.0",
    "file-loader": "6.2.0",
    "html-loader": "0.5.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "keyboardjs": "2.6.4",
    "knockout": "3.5.1",
    "libopus.js": "0.0.1",
    "mumble-client": "Flexpair/mumble-client#master",
    "netlify-identity-widget": "Flexpair/netlify-identity-widget#master",
    "node-polyfill-webpack-plugin": "^1.1.4",
    "playwright": "1.43.0",
    "promise": "8.1.0",
    "raw-loader": "4.0.2",
    "regexp-replace-loader": "1.0.1",
    "reuse-pool": "1.0.2",
    "sass": "1.52.3",
    "sass-loader": "13.0.0",
    "stream-chunker": "1.2.8",
    "subworkers": "1.0.1",
    "to-arraybuffer": "1.0.1",
    "transform-loader": "0.2.4",
    "wait-port": "^1.1.0",
    "web-audio-buffer-queue": "1.1.0",
    "webpack": "5.73.0",
    "webpack-cli": "4.10.0",
    "websocket-stream": "5.5.2",
    "worker-loader": "3.0.8",
    "ws": "^8.18.3"
  }
}
