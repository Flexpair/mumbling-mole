{
  "name": "mumbling-mole",
  "version": "0.5.1",
  "description": "An HTML5 Mumble client.",
  "scripts": {
    "build": "node build-esbuild.mjs",
    "build:dev": "BUILD_MODE=development node build-esbuild.mjs",
    "audit:ci": "node scripts/audit-ci.cjs",
    "audit:baseline": "node scripts/audit-ci.cjs --write-baseline",
    "prepare": "if [ -z \"$SKIP_PREPARE\" ]; then npm run build; fi",
    "test:audio": "node scripts/audio-test.cjs",
    "test:audio:system": "node scripts/audio-system-test.cjs",
    "test:audio:suite": "./scripts/run-audio-tests.sh",
    "test:loopback": "playwright test loopback-frequency.spec.js",
    "test:loopback:headed": "playwright test loopback-frequency.spec.js --headed",
    "test:loopback:debug": "playwright test loopback-frequency.spec.js --debug",
    "test:loopback:ui": "playwright test loopback-frequency.spec.js --ui",
    "test": "./scripts/run-all-tests.sh",
    "test:quick": "npm run test:audio:system && npm run audit:ci",
    "test:server:up": "cd .devcontainer && docker-compose up -d murmur",
    "test:server:down": "cd .devcontainer && docker-compose stop murmur",
    "test:server:logs": "cd .devcontainer && docker-compose logs -f murmur",
    "validate:markdown": "./scripts/validate-markdown-structure.sh",
    "check:deps": "npx depcheck --config .depcheckrc"
  },
  "author": "Jens Fielenbach <flexpair@icloud.com>",
  "repository": "Flexpair/mumbling-mole",
  "homepage": "https://github.com/Flexpair",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@playwright/test": "^1.56.1",
    "brfs": "2.0.2",
    "depcheck": "^1.4.7",
    "drop-stream": "1.0.0",
    "esbuild": "^0.25.11",
    "esbuild-sass-plugin": "^3.3.1",
    "keyboardjs": "2.7.0",
    "knockout": "3.5.1",
    "libopus.js": "0.0.1",
    "mumble-client": "file:vendors/mumble-client",
    "netlify-identity-widget": "file:vendors/netlify-identity-widget",
    "promise": "8.3.0",
    "resolve": "^1.22.10",
    "reuse-pool": "1.0.2",
    "sass": "^1.93.2",
    "stream-chunker": "1.2.8",
    "to-arraybuffer": "1.0.1",
    "wait-port": "^1.1.0",
    "websocket-stream": "^5.5.2",
    "ws": "^8.18.3"
  },
  "overrides": {
    "ws": "^8.18.3",
    "magic-string": "^0.30.10"
  }
}
