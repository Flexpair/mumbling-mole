# Playwright E2E Test Environment Variables
# Copy this file to .env.test and fill in your test credentials
#
# IMPORTANT: Never commit .env.test to version control!
# The .env.test file should be in .gitignore

# Test user credentials for Netlify Identity login
# These should be for a real test account on the Netlify Identity instance
PLAYWRIGHT_TEST_EMAIL=your-test-user@example.com
PLAYWRIGHT_TEST_PASSWORD=your-test-password

# Optional: Override the base URL for tests (auto-detected by default)
# PLAYWRIGHT_BASE_URL=https://local.flexpair.app
