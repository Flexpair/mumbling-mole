{
  "name": "App Dev (Multi-stage target=dev)",
  // Wir bauen mit unserem Multi-Stage-Dockerfile, Target = dev
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "target": "dev"
  },
  // Container läuft standardmäßig als 'node'
  "remoteUser": "node",
  // Wichtige Ordnerzuordnung:
  // - VS Code sieht /home/node als Workspace
  // - Dein lokales Repo wird genau dort gebind-mounted
  "workspaceFolder": "/home/node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/node,type=bind,consistency=cached",
  "overrideCommand": true,
  "runArgs": [
    "--init"
  ],
  // Beispiel für zusätzliche Umgebungsvariablen (falls nötig)
  "containerEnv": {
    "SKIP_PREPARE": "1"
  },
  // Nach Container-Erstellung: Dependencies installieren
  "postCreateCommand": "bash -lc 'cd /home/node && (npm ci --ignore-scripts --no-audit --no-fund || npm install --ignore-scripts --no-audit --no-fund) && npx update-browserslist-db@latest || true && npm run build'",
  // Nach jedem Start: Node- und npm-Version ausgeben
  "postStartCommand": "bash -lc 'cd /home/node && node -v && npm -v'",
  // Port-Weiterleitung (z. B. lokale App auf 8081)
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "App",
      "onAutoForward": "notify"
    }
  }
}