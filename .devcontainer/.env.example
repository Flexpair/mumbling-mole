# Auto-generated environment configuration (TEMPLATE)
# Copy to .env and replace values for local development
# IMPORTANT: Never commit .env with real credentials!
ENVIRONMENT=local
SSL_DOMAIN=local.flexpair.app

# Mumble server password - shared between auth-server and murmur.
# The compose file passes this to Murmur as MUMBLE_CONFIG_SERVER_PASSWORD.
# Generate new: openssl rand -base64 24 | tr -d '/+=' | head -c 32
MUMBLE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Optional role-specific Guacamole passwords; empty values use MUMBLE_PASSWORD.
GUAC_ADMIN_PASSWORD=
GUAC_EDITOR_PASSWORD=
GUAC_WATCHER_PASSWORD=

# Auth provider configuration
AUTH_PROVIDER=netlify
NETLIFY_IDENTITY_URL=https://welcome.flexpair.com/identity-proxy

# Comma-separated browser origins allowed to call the credential API
AUTH_ALLOWED_ORIGINS=https://local.flexpair.app
