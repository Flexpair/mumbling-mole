# Auto-generated environment configuration (TEMPLATE)
# Copy to .env and replace values for local development
# IMPORTANT: Never commit .env with real credentials!
ENVIRONMENT=local
SSL_DOMAIN=local.flexpair.app

# Murmur's server password is a fallback for unregistered users and is never
# returned by the auth API. Rotate it when enabling identity-bound auth.
MUMBLE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Murmur ICE write secret. Keep this private to the app and Murmur containers.
MURMUR_ICE_SECRET=REPLACE_WITH_DISTINCT_ICE_SECRET
# Required role-specific Guacamole passwords; use a different value for each role.
# Generate each independently: openssl rand -base64 24 | tr -d '/+=' | head -c 32
GUAC_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD
GUAC_EDITOR_PASSWORD=REPLACE_WITH_SECURE_EDITOR_PASSWORD
GUAC_WATCHER_PASSWORD=REPLACE_WITH_SECURE_WATCHER_PASSWORD

# Auth provider configuration
AUTH_PROVIDER=netlify
NETLIFY_IDENTITY_URL=https://welcome.flexpair.com/identity-proxy

# Comma-separated browser origins allowed to call the credential API
AUTH_ALLOWED_ORIGINS=https://local.flexpair.app
